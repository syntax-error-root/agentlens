# Environment
APP_ENV=development

# Server Binding
API_BIND_ADDR=0.0.0.0:8080
OTLP_HTTP_BIND_ADDR=0.0.0.0:4318

# Database (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev_change_me
POSTGRES_DB=agentlens
DATABASE_URL=postgres://postgres:postgres_local_dev_change_me@localhost:5432/agentlens

# Cache (Redis 7)
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_local_dev_change_me
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=agentlens-payloads

# Security Secrets (Must be 32+ bytes in production)
SESSION_SECRET=local_dev_session_secret_change_in_prod_12345
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
