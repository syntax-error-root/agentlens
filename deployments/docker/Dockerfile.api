# Multi-stage Dockerfile for agentlens-api
FROM rust:1.85-alpine AS builder

RUN apk add --no-cache musl-dev pkgconfig openssl-dev

WORKDIR /app
COPY . .

RUN cargo build --release --bin agentlens-api

FROM alpine:3.20 AS runner

RUN apk add --no-cache ca-certificates tzdata
RUN addgroup -S agentlens && adduser -S agentlens -G agentlens

USER agentlens
WORKDIR /app

COPY --from=builder /app/target/release/agentlens-api /app/agentlens-api

EXPOSE 8080 4318

ENTRYPOINT ["/app/agentlens-api"]
