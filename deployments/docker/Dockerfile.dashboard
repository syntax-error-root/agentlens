# Multi-stage Dockerfile for Next.js dashboard
FROM node:20-alpine AS base

FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY pnpm-lock.yaml* pnpm-workspace.yaml package.json ./
COPY apps/dashboard/package.json ./apps/dashboard/
COPY sdk/typescript/package.json ./sdk/typescript/
RUN corepack enable pnpm && pnpm install --frozen-lockfile=false

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN corepack enable pnpm && pnpm --filter dashboard build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -g 65532 -S agentlens && adduser -u 65532 -S agentlens -G agentlens

COPY --from=builder /app/apps/dashboard/public ./apps/dashboard/public
COPY --from=builder --chown=65532:65532 /app/apps/dashboard/.next/standalone ./
COPY --from=builder --chown=65532:65532 /app/apps/dashboard/.next/static ./apps/dashboard/.next/static

USER 65532:65532
EXPOSE 3000
ENV PORT=3000

CMD ["node", "apps/dashboard/server.js"]
